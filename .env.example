# PayPal sandbox app credentials, from developer.paypal.com → Apps & Credentials.
# This project talks to the sandbox only; the live API is never used.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The same client ID again. The PayPal web SDK needs it in the browser, where it is public by design.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# From developer.paypal.com → your app → Webhooks. Added once the site has a public URL.
PAYPAL_WEBHOOK_ID=

# GroqCloud API key, from console.groq.com.
GROQ_API_KEY=
